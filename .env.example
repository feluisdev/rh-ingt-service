SERVICE_PROFILE=development
SERVICE_PORT=8091

POSTGRES_HOST=localhost
POSTGRES_PORT=5436
POSTGRES_INTERNAL_PORT=5432
POSTGRES_DATABASE=recursoshumanos_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

AUTH_JWT_ISSUER=https://qa-ingt.gov.cv/auth/realms/igrp

# Disable JWT enforcement in development (token still parsed if present)
SECURITY_ENABLED=false

ENABLE_SWAGGER=true

MINIO_URL=http://127.0.0.1:9000
MINIO_PORT=9000
MINIO_SECURITY=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=rh-bucket
MINIO_PRESIGNED_URL_EXPIRATION_TIME=3600

# IGRP Access — endpoint e credenciais M2M da plataforma de gestao de acessos IGRP, usados
# pelo AuthorizationSyncRunner no arranque para sincronizar as permissoes declaradas em
# AppPermissions.java. Vem da propria plataforma; este ambiente nao as tem. Do not fill
# this with example values.
IGRP_ACCESS_API_BASE_URL=
IGRP_ACCESS_M2M_CLIENT_ID=
IGRP_ACCESS_M2M_CLIENT_SECRET=
IGRP_ACCESS_M2M_SCOPE=

OTEL_ENABLED=false
OTEL_TRACES_EXPORTER=none
OTEL_METRICS_EXPORTER=none
OTEL_LOGS_EXPORTER=none
OTEL_COLLECTOR_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=recursoshumanos-service
