{
  "type": "controller",
  "name": "ComplianceController",
  "module": "sigdi",
  "basePath": "api/v1/compliance",
  "description": "Compliance module — QUAR generation, SIADAP evaluations, quota validation",
  "actions": [
    {
      "actionName": "getQUARPreview",
      "method": "GET",
      "path": "quar/preview",
      "requestParams": [
        { "type": "integer", "name": "year",          "isRequired": true  },
        { "type": "string",  "name": "organicUnitId", "isRequired": false }
      ],
      "responses": {
        "200": {
          "name": "OK",
          "content": {
            "application/json": {
              "schema": {
                "type": "QUARPreviewResponse",
                "objectType": "dto",
                "name": "data",
                "collectionType": "none",
                "module": "sigdi"
              }
            }
          }
        }
      }
    },
    {
      "actionName": "exportQUAR",
      "method": "GET",
      "path": "quar/export",
      "requestParams": [
        { "type": "integer", "name": "year",          "isRequired": true  },
        { "type": "string",  "name": "format",        "isRequired": false },
        { "type": "string",  "name": "organicUnitId", "isRequired": false },
        { "type": "boolean", "name": "force",         "isRequired": false }
      ],
      "responses": {
        "200": {
          "name": "OK",
          "content": {
            "application/octet-stream": {
              "schema": {
                "type": "string",
                "collectionType": "none"
              }
            }
          }
        }
      }
    },
    {
      "actionName": "listEvaluations",
      "method": "GET",
      "path": "siadap/evaluations",
      "requestParams": [
        { "type": "integer", "name": "year",          "isRequired": true  },
        { "type": "string",  "name": "organicUnitId", "isRequired": false },
        { "type": "string",  "name": "status",        "isRequired": false },
        { "type": "string",  "name": "pageNumber",    "isRequired": false },
        { "type": "string",  "name": "pageSize",      "isRequired": false }
      ],
      "responses": {
        "200": {
          "name": "OK",
          "content": {
            "application/json": {
              "schema": {
                "type": "WrapperSiadapEvaluationList",
                "objectType": "dto",
                "name": "data",
                "collectionType": "none",
                "module": "sigdi"
              }
            }
          }
        }
      }
    },
    {
      "actionName": "quotaValidation",
      "method": "GET",
      "path": "siadap/quota-validation",
      "requestParams": [
        { "type": "integer", "name": "year", "isRequired": true }
      ],
      "responses": {
        "200": {
          "name": "OK",
          "content": {
            "application/json": {
              "schema": {
                "type": "QuotaValidationResponse",
                "objectType": "dto",
                "name": "data",
                "collectionType": "none",
                "module": "sigdi"
              }
            }
          }
        }
      }
    },
    {
      "actionName": "closeEvaluations",
      "method": "POST",
      "path": "siadap/evaluations/close",
      "requestBody": {
        "content": {
          "application/json": {
            "schema": {
              "type": "CloseEvaluationsRequest",
              "collectionType": "none",
              "name": "data",
              "objectType": "dto",
              "module": "sigdi"
            }
          }
        }
      },
      "responses": {
        "200": {
          "name": "OK",
          "content": {
            "application/json": {
              "schema": {
                "type": "CloseEvaluationsResponse",
                "objectType": "dto",
                "name": "data",
                "collectionType": "none",
                "module": "sigdi"
              }
            }
          }
        }
      }
    },
    {
      "actionName": "exportSiadap",
      "method": "GET",
      "path": "siadap/export",
      "requestParams": [
        { "type": "integer", "name": "year",          "isRequired": true  },
        { "type": "string",  "name": "organicUnitId", "isRequired": false },
        { "type": "string",  "name": "format",        "isRequired": false }
      ],
      "responses": {
        "200": {
          "name": "OK",
          "content": {
            "application/octet-stream": {
              "schema": {
                "type": "string",
                "collectionType": "none"
              }
            }
          }
        }
      }
    }
  ]
}
