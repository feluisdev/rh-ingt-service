          "name": "funcionarioId",
          "type": "string"
        },
        {
          "name": "licencaId",
          "type": "string"
        },
        {
          "name": "docId",
          "type": "string"
        }
      ]
    },
    {
      "actionName": "desativarDocumento",
      "method": "DELETE",
      "path": "{licencaId}/documentos/{docId}",
      "pathVariables": [
        {
          "name": "funcionarioId",
          "type": "string"
        },
        {
          "name": "licencaId",
          "type": "string"
        },
        {
          "name": "docId",
          "type": "string"
        }
      ],
