    {
      "actionName": "prorrogar",
      "method": "PUT",
      "path": "{licencaId}/prorrogar",
      "summary": "Prorroga a licença/mobilidade em vigor; o número de prorrogações e o período máximo vêm parametrizados no subtipo",
      "pathVariables": [
        {
          "name": "funcionarioId",
          "type": "string",
          "isRequired": true
        },
        {
          "name": "licencaId",
          "type": "string",
          "isRequired": true
        }
      ],
      "requestBody": {
        "content": {
          "application/json": {
            "schema": {
              "type": "ProrrogacaoMobilidadeRequestDTO",
              "objectType": "dto",
              "name": "data",
              "collectionType": "none",
              "module": "colaboradores"
            }
          }
        }
      },
      "responses": {
        "200": {
          "name": "OK",
          "content": {
            "application/json": {
              "schema": {
                "type": "ProrrogacaoMobilidadeResponseDTO",
                "objectType": "dto",
                "name": "data",
                "collectionType": "none",
                "module": "colaboradores"
              }
            }
          }
        }
