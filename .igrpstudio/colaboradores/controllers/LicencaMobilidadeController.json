        },
        {
          "name": "licencaId",
          "type": "string"
        }
      ]
    },
    {
      "actionName": "cancel",
      "method": "PUT",
      "path": "{licencaId}/cancel",
      "pathVariables": [
        {
          "name": "funcionarioId",
          "type": "string"
        },
        {
          "name": "licencaId",
          "type": "string"
        }
      ],
      "responses": {
        "200": {
          "name": "OK",
          "content": {
            "application/json": {
              "schema": {
                "type": "SuccessResponseDTO",
                "objectType": "dto",
                "name": "data",
                "collectionType": "none",
                "module": "shared"
              }
            }
          }
        }
      }
    },
    {
      "actionName": "ativar",
      "method": "PATCH",
      "path": "{licencaId}/ativar",
      "pathVariables": [
