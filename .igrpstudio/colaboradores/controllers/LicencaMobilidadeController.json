        {
          "name": "funcionarioId",
          "type": "string"
        },
        {
          "name": "licencaId",
          "type": "string"
        },
        {
          "name": "docId",
          "type": "string"
        }
      ]
    },
    {
      "actionName": "downloadDocumento",
      "method": "GET",
      "path": "{licencaId}/documentos/{docId}/download",
