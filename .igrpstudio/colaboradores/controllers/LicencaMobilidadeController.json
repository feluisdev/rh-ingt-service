      "method": "POST",
      "pathVariables": [
        {
          "name": "funcionarioId",
          "type": "string"
        }
      ],
      "requestBody": true,
      "responses": {
        "201": {
          "name": "Created",
          "content": {
            "application/json": {
              "schema": {
                "type": "SuccessResponseDTO",
                "objectType": "dto",
                "name": "data",
                "collectionType": "none",
                "module": "shared"
              }
            }
          }
        }
      }
    },
    {
      "actionName": "getAll",
      "method": "GET",
      "pathVariables": [
        {
          "name": "funcionarioId",
          "type": "string"
        }
      ],
      "requestParams": [
        {
          "name": "active",
          "type": "boolean",
          "required": false
        },
        {
          "name": "subtipoId",
          "type": "string",
          "required": false
        }
      ]
    },
    {
      "actionName": "getById",
      "method": "GET",
      "path": "{licencaId}",
      "pathVariables": [
        {
          "name": "funcionarioId",
          "type": "string"
        },
        {
          "name": "licencaId",
          "type": "string"
        }
      ]
    },
    {
      "actionName": "update",
      "method": "PUT",
      "path": "{licencaId}",
      "pathVariables": [
        {
          "name": "funcionarioId",
          "type": "string"
        },
        {
          "name": "licencaId",
          "type": "string"
        }
      ],
      "requestBody": true,
      "responses": {
        "200": {
          "name": "OK",
          "content": {
            "application/json": {
              "schema": {
                "type": "SuccessResponseDTO",
                "objectType": "dto",
                "name": "data",
                "collectionType": "none",
                "module": "shared"
              }
            }
          }
        }
      }
