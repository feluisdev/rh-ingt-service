            "application/json": {
              "schema": {
                "type": "SuccessResponseDTO",
                "objectType": "dto",
                "name": "data",
                "collectionType": "none",
                "module": "shared"
              }
            }
          }
        }
      }
    },
    {
      "actionName": "close",
      "method": "PUT",
