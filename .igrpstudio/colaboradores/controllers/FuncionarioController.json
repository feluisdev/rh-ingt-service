{
  "type": "controller",
  "name": "Funcionario",
  "module": "colaboradores",
  "basePath": "api/v1/rh/funcionarios",
  "description": "Gestão de funcionários",
  "actions": [
    {
      "actionName": "getFuncionarios",
      "method": "GET",
      "requestParams": [
        {"name": "nome",              "type": "string",  "required": false},
        {"name": "nif",               "type": "string",  "required": false},
        {"name": "workerStateId",     "type": "string",  "required": false},
        {"name": "unidadeOrganicaId", "type": "string",  "required": false},
        {"name": "careerId",          "type": "string",  "required": false},
        {"name": "active",            "type": "boolean", "required": false},
        {"name": "pagina",            "type": "string",  "required": false},
        {"name": "tamanho",           "type": "string",  "required": false}
      ]
    },
    {
      "actionName": "getFuncionarioById",
      "method": "GET",
      "path": "{funcionarioId}",
      "pathVariables": [
        {"name": "funcionarioId", "type": "string"}
      ]
    },
    {
      "actionName": "getColaboradorDetails",
      "method": "GET",
      "path": "{funcionarioId}/details",
      "pathVariables": [
        {"name": "funcionarioId", "type": "string", "isRequired": true}
      ],
      "responses": {
        "200": {
          "name": "OK",
          "content": {
            "application/json": {
              "schema": {
                "type": "ColaboradorDetailsResponseDTO",
                "objectType": "dto",
                "name": "data",
                "collectionType": "none",
                "module": "colaboradores"
              }
            }
          }
        }
      }
    },
    {
      "actionName": "createFuncionario",
      "method": "POST",
      "requestBody": true
    },
    {
      "actionName": "updateFuncionario",
      "method": "PUT",
      "path": "{funcionarioId}",
      "summary": "Actualizar dados pessoais e bancários do funcionário",
      "pathVariables": [
        {"name": "funcionarioId", "type": "string"}
      ],
      "requestBody": {
        "content": {
          "application/json": {
            "schema": {
              "type": "AtualizarFuncionarioRequestDTO",
              "objectType": "dto",
              "name": "data",
              "collectionType": "none",
              "module": "colaboradores"
            }
          }
        }
      },
      "responses": {
        "200": {
          "name": "OK",
          "content": {
            "application/json": {
              "schema": {
                "type": "map",
                "objectType": "java",
                "name": "data",
                "collectionType": "none"
              }
            }
          }
        }
      }
    },
    {
      "actionName": "mudarEstadoColaborador",
      "method": "PATCH",
      "path": "{funcionarioId}/worker-state",
      "summary": "Muda o estado do colaborador (ACTIVE, SUSPENDED, RETIRED, INACTIVE) com motivo, data de efectividade e efeitos em contrato/colocação",
      "pathVariables": [
        {"name": "funcionarioId", "type": "string", "isRequired": true}
      ],
      "requestBody": {
        "content": {
          "application/json": {
            "schema": {
              "type": "MudarEstadoColaboradorRequestDTO",
              "objectType": "dto",
              "name": "data",
              "collectionType": "none",
              "module": "colaboradores"
            }
          }
        }
      },
      "responses": {
        "200": {
          "name": "OK",
          "content": {
            "application/json": {
              "schema": {
                "type": "map",
                "objectType": "java",
                "name": "data",
                "collectionType": "none"
              }
            }
          }
        }
      }
    },
    {
      "actionName": "getHistoricoEstadoColaborador",
      "method": "GET",
      "path": "{funcionarioId}/worker-state/historico",
      "summary": "Lista o histórico de mudanças de estado do colaborador, ordenado por data efectividade descendente",
      "pathVariables": [
        {"name": "funcionarioId", "type": "string", "isRequired": true}
      ],
      "responses": {
        "200": {
          "name": "OK",
          "content": {
            "application/json": {
              "schema": {
                "type": "HistoricoEstadoColaboradorResponseDTO",
                "objectType": "dto",
                "name": "data",
                "collectionType": "list",
                "module": "colaboradores"
              }
            }
          }
        }
      }
    },
    {
      "actionName": "getEnquadramentoAtual",
      "method": "GET",
      "path": "{funcionarioId}/enquadramento",
      "pathVariables": [
        {"name": "funcionarioId", "type": "string"}
      ]
    },
    {
      "actionName": "getEnquadramentosHistorico",
      "method": "GET",
      "path": "{funcionarioId}/enquadramentos/historico",
      "pathVariables": [
        {"name": "funcionarioId", "type": "string"}
      ]
    },
    {
      "actionName": "getContratosByFuncionario",
      "method": "GET",
      "path": "{funcionarioId}/contratos",
      "pathVariables": [
        {"name": "funcionarioId", "type": "string"}
      ]
    },
    {
      "actionName": "getDependentesByFuncionario",
      "method": "GET",
      "path": "{funcionarioId}/dependentes",
      "pathVariables": [
        {"name": "funcionarioId", "type": "string"}
      ]
    },
    {
      "actionName": "getQualificacoesByFuncionario",
      "method": "GET",
      "path": "{funcionarioId}/qualificacoes",
      "pathVariables": [
        {"name": "funcionarioId", "type": "string"}
      ]
    },
    {
      "actionName": "registarColaborador",
      "method": "POST",
      "path": "registar",
      "requestBody": {
        "content": {
          "application/json": {
            "schema": {
              "type": "RegistarColaboradorRequestDTO",
              "objectType": "dto"
            }
          }
        }
      },
      "responses": {
        "201": {
          "name": "Created",
          "content": {
            "application/json": {
              "schema": {
                "type": "RegistarColaboradorResponseDTO",
                "objectType": "dto"
              }
            }
          }
        }
      }
    },
    {
      "actionName": "getCombobox",
      "path": "combobox",
      "method": "GET",
      "requestParams": [
        {"type": "string", "name": "q",                "isRequired": false},
        {"type": "string", "name": "unidadeOrganicaId","isRequired": false},
        {"type": "string", "name": "workerStateId",    "isRequired": false}
      ],
      "responses": {
        "200": {
          "name": "OK",
          "content": {
            "application/json": {
              "schema": {
                "type": "ComboboxItem",
                "objectType": "dto",
                "collectionType": "list",
                "module": "shared"
              }
            }
          }
        }
      }
    }
  ]
}
