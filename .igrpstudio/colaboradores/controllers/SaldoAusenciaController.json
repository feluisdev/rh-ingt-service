{
  "type": "controller",
  "name": "SaldoAusencia",
  "module": "colaboradores",
  "basePath": "api/v1/rh/funcionarios/{funcionarioId}/saldos-ausencia",
  "description": "Gestão de saldos de ausência de funcionários",
  "actions": [
    {
      "actionName": "create",
      "method": "POST",
      "pathVariables": [
        {
          "name": "funcionarioId",
          "type": "string"
        }
      ],
      "requestBody": true,
      "responses": {
        "201": {
          "name": "Created",
          "content": {
            "application/json": {
              "schema": {
                "type": "SuccessResponseDTO",
                "objectType": "dto",
                "name": "data",
                "collectionType": "none",
                "module": "shared"
              }
            }
          }
        }
      }
    },
    {
      "actionName": "getAll",
      "method": "GET",
      "pathVariables": [
        {
          "name": "funcionarioId",
          "type": "string"
        }
      ],
      "requestParams": [
        {
          "name": "ano",
          "type": "integer",
          "required": false
        },
        {
          "name": "tipoAusenciaId",
          "type": "string",
          "required": false
        }
      ]
    },
    {
      "actionName": "getById",
      "method": "GET",
      "path": "{saldoId}",
      "pathVariables": [
        {
          "name": "funcionarioId",
          "type": "string"
        },
        {
          "name": "saldoId",
          "type": "string"
        }
      ]
    },
    {
      "actionName": "update",
      "method": "PUT",
      "path": "{saldoId}",
      "pathVariables": [
        {
          "name": "funcionarioId",
          "type": "string"
        },
        {
          "name": "saldoId",
          "type": "string"
        }
      ],
      "requestParams": [
        {
          "name": "diasDireito",
          "type": "integer",
          "required": true
        }
      ],
      "responses": {
        "200": {
          "name": "OK",
          "content": {
            "application/json": {
              "schema": {
                "type": "SuccessResponseDTO",
                "objectType": "dto",
                "name": "data",
                "collectionType": "none",
                "module": "shared"
              }
            }
          }
        }
      }
    }
  ]
}
