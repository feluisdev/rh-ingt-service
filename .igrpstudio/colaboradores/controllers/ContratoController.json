{
  "type": "controller",
  "name": "Contrato",
  "module": "colaboradores",
  "basePath": "api/v1/rh/contratos",
  "description": "Gestão de contratos laborais",
  "actions": [
    {
      "actionName": "createContrato",
      "method": "POST",
      "requestBody": true
    },
    {
      "actionName": "getContratoById",
      "method": "GET",
      "path": "{contratoId}",
      "pathVariables": [
        {"name": "contratoId", "type": "string"}
      ]
    },
    {
      "actionName": "updateContrato",
      "method": "PUT",
      "path": "{contratoId}",
      "pathVariables": [
        {"name": "contratoId", "type": "string"}
      ],
      "requestBody": true
    },
    {
      "actionName": "deactivateContrato",
      "method": "DELETE",
      "path": "{contratoId}",
      "pathVariables": [
        {"name": "contratoId", "type": "string"}
      ]
    },
    {
      "actionName": "activateContrato",
      "method": "PUT",
      "path": "{contratoId}/activate",
      "pathVariables": [
        {"name": "contratoId", "type": "string"}
      ]
    },
    {
      "actionName": "registarDocumento",
      "method": "POST",
      "path": "{contratoId}/documentos",
      "pathVariables": [
        {"name": "contratoId", "type": "string"}
      ],
      "requestBody": true
    },
    {
      "actionName": "listarDocumentos",
      "method": "GET",
      "path": "{contratoId}/documentos",
      "pathVariables": [
        {"name": "contratoId", "type": "string"}
      ],
      "requestParams": [
        {"name": "documentTypeId", "type": "string", "required": false},
        {"name": "active", "type": "boolean", "required": false}
      ]
    },
    {
      "actionName": "getDocumentoById",
      "method": "GET",
      "path": "{contratoId}/documentos/{docId}",
      "pathVariables": [
        {"name": "contratoId", "type": "string"},
        {"name": "docId", "type": "string"}
      ]
    },
    {
      "actionName": "downloadDocumento",
      "method": "GET",
      "path": "{contratoId}/documentos/{docId}/download",
      "pathVariables": [
        {"name": "contratoId", "type": "string"},
        {"name": "docId", "type": "string"}
      ]
    },
    {
      "actionName": "desativarDocumento",
      "method": "DELETE",
      "path": "{contratoId}/documentos/{docId}",
      "pathVariables": [
        {"name": "contratoId", "type": "string"},
        {"name": "docId", "type": "string"}
      ]
    }
  ]
}
