{
  "type": "controller",
  "name": "ContratoController",
  "module": "colaboradores",
  "basePath": "api/v1/rh/funcionarios/{funcionarioId}/contratos",
  "description": "Gestão de contratos laborais dos funcionários",
  "actions": [
    {
      "actionName": "getContratosByFuncionario",
      "method": "GET",
      "path": "",
      "pathVariables": [
        {
          "type": "string",
          "name": "funcionarioId",
          "isRequired": true
        }
      ],
      "responses": {
        "200": {
          "name": "OK",
          "content": {
            "application/json": {
              "schema": {
                "type": "WrapperListaContratoDTO",
                "objectType": "dto",
                "name": "data",
                "collectionType": "none",
                "module": "colaboradores"
              }
            }
          }
        }
      }
    },
    {
      "actionName": "createContrato",
      "method": "POST",
      "path": "",
      "requestBody": {
        "content": {
          "application/json": {
            "schema": {
              "type": "ContratoRequest",
              "collectionType": "none",
              "name": "data",
              "objectType": "dto",
              "module": "colaboradores"
            }
          }
        }
      },
      "responses": {
        "201": {
          "name": "CREATED",
          "content": {
            "application/json": {
              "schema": {
                "type": "SuccessResponseDTO",
                "objectType": "dto",
                "name": "data",
                "collectionType": "none",
                "module": "shared"
              }
            }
          }
        }
      }
    },
    {
      "actionName": "getContratoById",
      "method": "GET",
      "path": "{contratoId}",
      "pathVariables": [
        {
          "type": "string",
          "name": "contratoId",
          "isRequired": true
        }
      ],
      "responses": {
        "200": {
          "name": "OK",
          "content": {
            "application/json": {
              "schema": {
                "type": "ContratoResponseDTO",
                "objectType": "dto",
                "name": "data",
                "collectionType": "none",
                "module": "colaboradores"
              }
            }
          }
        }
      }
    },
    {
      "actionName": "updateContrato",
      "method": "PUT",
      "path": "{contratoId}",
      "pathVariables": [
        {
          "type": "string",
          "name": "contratoId",
          "isRequired": true
        }
      ],
      "requestBody": {
        "content": {
          "application/json": {
            "schema": {
              "type": "ContratoRequest",
              "collectionType": "none",
              "name": "data",
              "objectType": "dto",
              "module": "colaboradores"
            }
          }
        }
      },
      "responses": {
        "200": {
          "name": "OK",
          "content": {
            "application/json": {
              "schema": {
                "type": "ContratoResponseDTO",
                "objectType": "dto",
                "name": "data",
                "collectionType": "none",
                "module": "colaboradores"
              }
            }
          }
        }
      }
    },
    {
      "actionName": "deactivateContrato",
      "method": "DELETE",
      "path": "{contratoId}",
      "pathVariables": [
        {
          "type": "string",
          "name": "contratoId",
          "isRequired": true
        }
      ],
      "responses": {
        "200": {
          "name": "OK",
          "content": {
            "application/json": {
              "schema": {
                "type": "SuccessResponseDTO",
                "objectType": "dto",
                "name": "data",
                "collectionType": "none",
                "module": "shared"
              }
            }
          }
        }
      }
    },
    {
      "actionName": "closeContrato",
      "method": "PUT",
      "path": "{contratoId}/close",
      "summary": "Encerrar contrato = cessação do vínculo: cessa o contrato, encerra a afectação corrente (o Lugar fica vago), muda o estado do trabalhador e regista o histórico",
      "pathVariables": [
        {
          "type": "string",
          "name": "contratoId",
          "isRequired": true
        }
      ],
      "requestBody": {
        "content": {
          "application/json": {
            "schema": {
              "type": "CloseContratoRequest",
              "collectionType": "none",
              "name": "data",
              "objectType": "dto",
              "module": "colaboradores"
            }
          }
        }
      },
      "responses": {
        "200": {
          "name": "OK",
          "content": {
            "application/json": {
              "schema": {
                "type": "EstadoColaboradorResponseDTO",
                "objectType": "dto",
                "name": "data",
                "collectionType": "none",
                "module": "colaboradores"
              }
            }
          }
        }
      }
    },
    {
      "actionName": "suspendContrato",
      "method": "PUT",
      "path": "{contratoId}/suspend",
      "summary": "Suspender contrato — transição ATIVO → SUSPENSO",
      "pathVariables": [
        {
          "type": "string",
          "name": "contratoId",
          "isRequired": true
        }
      ],
      "responses": {
        "200": {
          "name": "OK",
          "content": {
            "application/json": {
              "schema": {
                "type": "SuccessResponseDTO",
                "objectType": "dto",
                "name": "data",
                "collectionType": "none",
                "module": "shared"
              }
            }
          }
        }
      }
    },
    {
      "actionName": "activateContrato",
      "method": "PUT",
      "path": "{contratoId}/activate",
      "summary": "Reactivar contrato suspenso — transição SUSPENSO → ATIVO",
      "pathVariables": [
        {
          "type": "string",
          "name": "contratoId",
          "isRequired": true
        }
      ],
      "responses": {
        "200": {
          "name": "OK",
          "content": {
            "application/json": {
              "schema": {
                "type": "SuccessResponseDTO",
                "objectType": "dto",
                "name": "data",
                "collectionType": "none",
                "module": "shared"
              }
            }
          }
        }
      }
    },
    {
      "actionName": "registarDocumento",
      "method": "POST",
      "path": "{contratoId}/documentos",
      "pathVariables": [
        {
          "type": "string",
          "name": "contratoId",
          "isRequired": true
        }
      ],
      "requestBody": {
        "content": {
          "application/json": {
            "schema": {
              "type": "UploadDocumentoRequest",
              "collectionType": "none",
              "name": "data",
              "objectType": "dto",
              "module": "colaboradores"
            }
          }
        }
      },
      "responses": {
        "201": {
          "name": "CREATED",
          "content": {
            "application/json": {
              "schema": {
                "type": "DocumentoUploadResponseDTO",
                "objectType": "dto",
                "name": "data",
                "collectionType": "none",
                "module": "colaboradores"
              }
            }
          }
        }
      }
    },
    {
      "actionName": "listarDocumentos",
      "method": "GET",
      "path": "{contratoId}/documentos",
      "pathVariables": [
        {
          "type": "string",
          "name": "contratoId",
          "isRequired": true
        }
      ],
      "requestParams": [
        {
          "type": "uuid",
          "name": "documentTypeId",
          "isRequired": false
        },
        {
          "type": "boolean",
          "name": "active",
          "isRequired": false
        }
      ],
      "responses": {
        "200": {
          "name": "OK",
          "content": {
            "application/json": {
              "schema": {
                "type": "WrapperListaDocumentoDTO",
                "objectType": "dto",
                "name": "data",
                "collectionType": "none",
                "module": "colaboradores"
              }
            }
          }
        }
      }
    },
    {
      "actionName": "getDocumentoById",
      "method": "GET",
      "path": "{contratoId}/documentos/{docId}",
      "pathVariables": [
        {
          "type": "string",
          "name": "contratoId",
          "isRequired": true
        },
        {
          "type": "string",
          "name": "docId",
          "isRequired": true
        }
      ],
      "responses": {
        "200": {
          "name": "OK",
          "content": {
            "application/json": {
              "schema": {
                "type": "DocumentoResponseDTO",
                "objectType": "dto",
                "name": "data",
                "collectionType": "none",
                "module": "colaboradores"
              }
            }
          }
        }
      }
    },
    {
      "actionName": "downloadDocumento",
      "method": "GET",
      "path": "{contratoId}/documentos/{docId}/download",
      "pathVariables": [
        {
          "type": "string",
          "name": "contratoId",
          "isRequired": true
        },
        {
          "type": "string",
          "name": "docId",
          "isRequired": true
        }
      ],
      "responses": {
        "200": {
          "name": "OK",
          "content": {
            "application/json": {
              "schema": {
                "type": "DocumentoDownloadResponseDTO",
                "objectType": "dto",
                "name": "data",
                "collectionType": "none",
                "module": "colaboradores"
              }
            }
          }
        }
      }
    },
    {
      "actionName": "desativarDocumento",
      "method": "DELETE",
      "path": "{contratoId}/documentos/{docId}",
      "pathVariables": [
        {
          "type": "string",
          "name": "contratoId",
          "isRequired": true
        },
        {
          "type": "string",
          "name": "docId",
          "isRequired": true
        }
      ],
      "responses": {
        "200": {
          "name": "OK",
          "content": {
            "application/json": {
              "schema": {
                "type": "SuccessResponseDTO",
                "objectType": "dto",
                "name": "data",
                "collectionType": "none",
                "module": "shared"
              }
            }
          }
        }
      }
    }
  ]
}
