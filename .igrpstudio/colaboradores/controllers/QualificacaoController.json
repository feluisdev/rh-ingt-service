{
  "type": "controller",
  "name": "Qualificacao",
  "module": "colaboradores",
  "basePath": "api/v1/rh/qualificacoes",
  "description": "Gestão de qualificações académicas de funcionários",
  "actions": [
    {
      "actionName": "createQualificacao",
      "method": "POST",
      "requestBody": true
    },
    {
      "actionName": "getQualificacaoById",
      "method": "GET",
      "path": "{qualificacaoId}",
      "pathVariables": [
        {"name": "qualificacaoId", "type": "string"}
      ]
    },
    {
      "actionName": "updateQualificacao",
      "method": "PUT",
      "path": "{qualificacaoId}",
      "pathVariables": [
        {"name": "qualificacaoId", "type": "string"}
      ],
      "requestBody": true
    },
    {
      "actionName": "deactivateQualificacao",
      "method": "DELETE",
      "path": "{qualificacaoId}",
      "pathVariables": [
        {"name": "qualificacaoId", "type": "string"}
      ]
    },
    {
      "actionName": "activateQualificacao",
      "method": "PUT",
      "path": "{qualificacaoId}/activate",
      "pathVariables": [
        {"name": "qualificacaoId", "type": "string"}
      ]
    },
    {
      "actionName": "registarDocumento",
      "method": "POST",
      "path": "{qualificacaoId}/documentos",
      "pathVariables": [
        {"name": "qualificacaoId", "type": "string"}
      ],
      "requestBody": true
    },
    {
      "actionName": "listarDocumentos",
      "method": "GET",
      "path": "{qualificacaoId}/documentos",
      "pathVariables": [
        {"name": "qualificacaoId", "type": "string"}
      ],
      "requestParams": [
        {"name": "documentTypeId", "type": "string", "required": false},
        {"name": "active", "type": "boolean", "required": false}
      ]
    },
    {
      "actionName": "getDocumentoById",
      "method": "GET",
      "path": "{qualificacaoId}/documentos/{docId}",
      "pathVariables": [
        {"name": "qualificacaoId", "type": "string"},
        {"name": "docId", "type": "string"}
      ]
    },
    {
      "actionName": "downloadDocumento",
      "method": "GET",
      "path": "{qualificacaoId}/documentos/{docId}/download",
      "pathVariables": [
        {"name": "qualificacaoId", "type": "string"},
        {"name": "docId", "type": "string"}
      ]
    },
    {
      "actionName": "desativarDocumento",
      "method": "DELETE",
      "path": "{qualificacaoId}/documentos/{docId}",
      "pathVariables": [
        {"name": "qualificacaoId", "type": "string"},
        {"name": "docId", "type": "string"}
      ]
    }
  ]
}
