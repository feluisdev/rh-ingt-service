{
  "type": "controller",
  "name": "Colocacao",
  "module": "colaboradores",
  "basePath": "api/v1/rh/funcionarios/{funcionarioId}/colocacoes",
  "description": "Gestão de colocações de funcionários em unidades orgânicas",
  "actions": [
    {
      "actionName": "registarColocacao",
      "method": "POST",
      "pathVariables": [
        {"name": "funcionarioId", "type": "string"}
      ],
      "requestBody": true
    },
    {
      "actionName": "listarColocacoes",
      "method": "GET",
      "pathVariables": [
        {"name": "funcionarioId", "type": "string"}
      ],
      "requestParams": [
        {"name": "current", "type": "boolean", "required": false}
      ]
    },
    {
      "actionName": "getColocacaoAtual",
      "method": "GET",
      "path": "atual",
      "pathVariables": [
        {"name": "funcionarioId", "type": "string"}
      ]
    },
    {
      "actionName": "getColocacaoById",
      "method": "GET",
      "path": "{colocacaoId}",
      "pathVariables": [
        {"name": "funcionarioId", "type": "string"},
        {"name": "colocacaoId", "type": "string"}
      ]
    },
    {
      "actionName": "atualizarColocacao",
      "method": "PUT",
      "path": "{colocacaoId}",
      "pathVariables": [
        {"name": "funcionarioId", "type": "string"},
        {"name": "colocacaoId", "type": "string"}
      ],
      "requestBody": true
    },
    {
      "actionName": "encerrarColocacao",
      "method": "PUT",
      "path": "{colocacaoId}/close",
      "pathVariables": [
        {"name": "funcionarioId", "type": "string"},
        {"name": "colocacaoId", "type": "string"}
      ]
    },
    {
      "actionName": "desativarColocacao",
      "method": "DELETE",
      "path": "{colocacaoId}",
      "pathVariables": [
        {"name": "funcionarioId", "type": "string"},
        {"name": "colocacaoId", "type": "string"}
      ]
    }
  ]
}
