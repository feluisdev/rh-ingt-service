{
  "type": "controller",
  "name": "Recibo",
  "module": "colaboradores",
  "basePath": "api/v1/rh",
  "description": "Gestão de recibos de vencimento dos funcionários",
  "actions": [
    {
      "actionName": "listarRecibos",
      "method": "GET",
      "path": "funcionarios/{funcionarioId}/recibos",
      "pathVariables": [
        {"name": "funcionarioId", "type": "string"}
      ],
      "requestParams": [
        {"name": "periodYear", "type": "integer", "required": false},
        {"name": "periodMonth", "type": "integer", "required": false}
      ]
    },
    {
      "actionName": "getReciboById",
      "method": "GET",
      "path": "recibos/{reciboId}",
      "pathVariables": [
        {"name": "reciboId", "type": "string"}
      ]
    },
    {
      "actionName": "criarRecibo",
      "method": "POST",
      "path": "funcionarios/{funcionarioId}/recibos",
      "pathVariables": [
        {"name": "funcionarioId", "type": "string"}
      ],
      "requestBody": true
    },
    {
      "actionName": "registarDocumento",
      "method": "POST",
      "path": "funcionarios/{funcionarioId}/recibos/{reciboId}/documentos",
      "pathVariables": [
        {"name": "funcionarioId", "type": "string"},
        {"name": "reciboId", "type": "string"}
      ],
      "requestBody": true
    },
    {
      "actionName": "listarDocumentos",
      "method": "GET",
      "path": "funcionarios/{funcionarioId}/recibos/{reciboId}/documentos",
      "pathVariables": [
        {"name": "funcionarioId", "type": "string"},
        {"name": "reciboId", "type": "string"}
      ],
      "requestParams": [
        {"name": "documentTypeId", "type": "string", "required": false},
        {"name": "active", "type": "boolean", "required": false}
      ]
    },
    {
      "actionName": "getDocumentoById",
      "method": "GET",
      "path": "funcionarios/{funcionarioId}/recibos/{reciboId}/documentos/{docId}",
      "pathVariables": [
        {"name": "funcionarioId", "type": "string"},
        {"name": "reciboId", "type": "string"},
        {"name": "docId", "type": "string"}
      ]
    },
    {
      "actionName": "downloadDocumento",
      "method": "GET",
      "path": "funcionarios/{funcionarioId}/recibos/{reciboId}/documentos/{docId}/download",
      "pathVariables": [
        {"name": "funcionarioId", "type": "string"},
        {"name": "reciboId", "type": "string"},
        {"name": "docId", "type": "string"}
      ]
    },
    {
      "actionName": "desativarDocumento",
      "method": "DELETE",
      "path": "funcionarios/{funcionarioId}/recibos/{reciboId}/documentos/{docId}",
      "pathVariables": [
        {"name": "funcionarioId", "type": "string"},
        {"name": "reciboId", "type": "string"},
        {"name": "docId", "type": "string"}
      ]
    }
  ]
}
