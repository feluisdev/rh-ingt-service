{
  "type": "controller",
  "name": "ReciboController",
  "module": "colaboradores",
  "basePath": "api/v1/rh/funcionarios/{funcionarioId}/recibos",
  "description": "Gestão de recibos de vencimento dos funcionários",
  "actions": [
    {
      "actionName": "listarRecibos",
      "method": "GET",
      "path": "",
      "pathVariables": [{ "type": "string", "name": "funcionarioId", "isRequired": true }],
      "requestParams": [
        { "type": "integer", "name": "periodYear",  "isRequired": false },
        { "type": "integer", "name": "periodMonth", "isRequired": false }
      ],
      "responses": { "200": { "name": "OK", "content": { "application/json": { "schema": { "type": "WrapperListaRecibo", "objectType": "dto", "name": "data", "collectionType": "none", "module": "colaboradores" } } } } }
    },
    {
      "actionName": "getReciboById",
      "method": "GET",
      "path": "{reciboId}",
      "pathVariables": [{ "type": "string", "name": "funcionarioId", "isRequired": true }, { "type": "string", "name": "reciboId", "isRequired": true }],
      "responses": { "200": { "name": "OK", "content": { "application/json": { "schema": { "type": "ReciboVencimento", "objectType": "dto", "name": "data", "collectionType": "none", "module": "colaboradores" } } } } }
    },
    {
      "actionName": "criarRecibo",
      "method": "POST",
      "path": "",
      "pathVariables": [{ "type": "string", "name": "funcionarioId", "isRequired": true }],
      "requestBody": { "content": { "application/json": { "schema": { "type": "CriarReciboRequest", "collectionType": "none", "name": "data", "objectType": "dto", "module": "colaboradores" } } } },
      "responses": { "201": { "name": "CREATED", "content": { "application/json": { "schema": { "type": "map", "objectType": "java", "name": "data", "collectionType": "none" } } } } }
    },
    {
      "actionName": "registarDocumento",
      "method": "POST",
      "path": "{reciboId}/documentos",
      "pathVariables": [{ "type": "string", "name": "funcionarioId", "isRequired": true }, { "type": "string", "name": "reciboId", "isRequired": true }],
      "requestBody": { "content": { "application/json": { "schema": { "type": "UploadDocumentoRequest", "collectionType": "none", "name": "data", "objectType": "dto", "module": "colaboradores" } } } },
      "responses": { "201": { "name": "CREATED", "content": { "application/json": { "schema": { "type": "DocumentoUploadResponse", "objectType": "dto", "name": "data", "collectionType": "none", "module": "colaboradores" } } } } }
    },
    {
      "actionName": "listarDocumentos",
      "method": "GET",
      "path": "{reciboId}/documentos",
      "pathVariables": [{ "type": "string", "name": "funcionarioId", "isRequired": true }, { "type": "string", "name": "reciboId", "isRequired": true }],
      "requestParams": [{ "type": "uuid", "name": "documentTypeId", "isRequired": false }, { "type": "boolean", "name": "active", "isRequired": false }],
      "responses": { "200": { "name": "OK", "content": { "application/json": { "schema": { "type": "WrapperListaDocumento", "objectType": "dto", "name": "data", "collectionType": "none", "module": "colaboradores" } } } } }
    },
    {
      "actionName": "getDocumentoById",
      "method": "GET",
      "path": "{reciboId}/documentos/{docId}",
      "pathVariables": [{ "type": "string", "name": "funcionarioId", "isRequired": true }, { "type": "string", "name": "reciboId", "isRequired": true }, { "type": "string", "name": "docId", "isRequired": true }],
      "responses": { "200": { "name": "OK", "content": { "application/json": { "schema": { "type": "DocumentoResponse", "objectType": "dto", "name": "data", "collectionType": "none", "module": "colaboradores" } } } } }
    },
    {
      "actionName": "downloadDocumento",
      "method": "GET",
      "path": "{reciboId}/documentos/{docId}/download",
      "pathVariables": [{ "type": "string", "name": "funcionarioId", "isRequired": true }, { "type": "string", "name": "reciboId", "isRequired": true }, { "type": "string", "name": "docId", "isRequired": true }],
      "responses": { "200": { "name": "OK", "content": { "application/json": { "schema": { "type": "DocumentoDownloadResponse", "objectType": "dto", "name": "data", "collectionType": "none", "module": "colaboradores" } } } } }
    },
    {
      "actionName": "desativarDocumento",
      "method": "DELETE",
      "path": "{reciboId}/documentos/{docId}",
      "pathVariables": [{ "type": "string", "name": "funcionarioId", "isRequired": true }, { "type": "string", "name": "reciboId", "isRequired": true }, { "type": "string", "name": "docId", "isRequired": true }],
      "responses": { "200": { "name": "OK", "content": { "application/json": { "schema": { "type": "map", "objectType": "java", "name": "data", "collectionType": "none" } } } } }
    }
  ]
}
