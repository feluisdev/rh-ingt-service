      "method": "DELETE",
      "path": "{formacaoId}/documentos/{docId}",
      "pathVariables": [
        {
          "name": "funcionarioId",
          "type": "string"
        },
        {
          "name": "formacaoId",
          "type": "string"
        },
        {
          "name": "docId",
          "type": "string"
        }
      ],
      "responses": {
        "200": {
          "name": "OK",
          "content": {
            "application/json": {
              "schema": {
                "type": "SuccessResponseDTO",
                "objectType": "dto",
                "name": "data",
                "collectionType": "none",
                "module": "shared"
              }
            }
          }
        }
