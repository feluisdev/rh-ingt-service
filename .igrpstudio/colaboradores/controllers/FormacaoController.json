      "path": "{formacaoId}",
      "pathVariables": [
        {
          "name": "funcionarioId",
          "type": "string"
        },
        {
          "name": "formacaoId",
          "type": "string"
        }
      ],
      "requestBody": true,
      "responses": {
        "200": {
          "name": "OK",
          "content": {
            "application/json": {
              "schema": {
                "type": "SuccessResponseDTO",
                "objectType": "dto",
                "name": "data",
                "collectionType": "none",
                "module": "shared"
              }
            }
          }
        }
      }
    },
    {
      "actionName": "removerFormacao",
      "method": "DELETE",
      "path": "{formacaoId}",
