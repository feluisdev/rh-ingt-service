      "responses": {
        "200": {
          "name": "OK",
          "content": {
            "application/json": {
              "schema": {
                "type": "DocumentoDownloadResponseDTO",
                "objectType": "dto",
                "name": "data",
                "collectionType": "none",
                "module": "colaboradores"
              }
            }
          }
