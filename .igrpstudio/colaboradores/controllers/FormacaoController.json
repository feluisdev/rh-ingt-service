        {
          "name": "funcionarioId",
          "type": "string"
        }
      ],
      "requestParams": [
        {
          "name": "year",
          "type": "integer",
          "required": false
        }
      ],
      "responses": {
        "200": {
          "name": "OK",
          "content": {
            "application/json": {
              "schema": {
                "type": "WrapperListaFormacaoDTO",
                "objectType": "dto",
                "name": "data",
                "collectionType": "none",
                "module": "colaboradores"
              }
            }
          }
        }
      }
    },
    {
      "actionName": "getFormacaoById",
      "method": "GET",
