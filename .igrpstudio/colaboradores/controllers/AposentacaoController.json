    {
      "actionName": "getRelatorioAposentacao",
      "method": "GET",
      "path": "relatorios/aposentacao",
      "summary": "Quem, no serviço, atinge o limite de idade ou reúne as condições da antecipada ou da pré-aposentação até uma data (por omissão, 12 meses)",
      "requestParams": [
        {
          "type": "string",
          "name": "unidadeId",
          "isRequired": true
        },
        {
          "type": "boolean",
          "name": "incluirSubunidades",
          "isRequired": false
        },
        {
          "type": "date",
          "name": "ate",
          "isRequired": false
