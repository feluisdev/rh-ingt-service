      "actionName": "getRelatorioAposentacaoCsv",
      "method": "GET",
      "path": "relatorios/aposentacao.csv",
      "summary": "O mesmo relatório em CSV (separador ;, UTF-8 com BOM)",
      "requestParams": [
        {
          "type": "string",
          "name": "unidadeId",
          "isRequired": true
        },
        {
          "type": "boolean",
          "name": "incluirSubunidades",
          "isRequired": false
        },
        {
          "type": "date",
          "name": "ate",
          "isRequired": false
