{
  "type": "controller",
  "name": "Aposentacao",
  "module": "colaboradores",
  "basePath": "api/v1/rh",
  "description": "Aposentação e limite de idade (Lei n.º 20/X/2023, arts. 48.º e 173.º–179.º): situação de cada colaborador, relatório por serviço, processo de aposentação e prorrogação para além dos 65 anos",
  "actions": [
    {
      "actionName": "getSituacaoAposentacao",
      "method": "GET",
      "path": "funcionarios/{funcionarioId}/aposentacao",
      "summary": "A situação do colaborador perante a aposentação: limite de idade, tempo de serviço, condições, processos e prorrogações",
      "pathVariables": [
        {
          "name": "funcionarioId",
          "type": "string"
        }
      ],
      "responses": {
        "200": {
          "name": "OK",
          "content": {
            "application/json": {
              "schema": {
                "type": "SituacaoAposentacaoDTO",
                "objectType": "dto",
                "name": "data",
                "collectionType": "none",
                "module": "colaboradores"
              }
            }
          }
        }
      }
    },
    {
      "actionName": "abrirProcessoAposentacao",
      "method": "POST",
      "path": "funcionarios/{funcionarioId}/aposentacao/processos",
      "summary": "Abrir um processo de aposentação (RH)",
      "pathVariables": [
        {
          "name": "funcionarioId",
          "type": "string"
        }
      ],
      "requestBody": {
        "content": {
          "application/json": {
            "schema": {
              "type": "ProcessoAposentacaoRequest",
              "collectionType": "none",
              "name": "data",
              "objectType": "dto",
              "module": "colaboradores"
            }
          }
        }
      },
      "responses": {
        "201": {
          "name": "Created",
          "content": {
            "application/json": {
              "schema": {
                "type": "ProcessoAposentacaoDTO",
                "objectType": "dto",
                "name": "data",
                "collectionType": "none",
                "module": "colaboradores"
              }
            }
          }
        }
      }
    },
