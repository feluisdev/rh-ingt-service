      "method": "PATCH",
      "path": "funcionarios/{funcionarioId}/aposentacao/processos/{processoId}/deferir",
      "summary": "Deferir o processo: o despacho que autoriza",
      "pathVariables": [
        {
          "name": "funcionarioId",
          "type": "string"
        },
        {
          "name": "processoId",
          "type": "string"
