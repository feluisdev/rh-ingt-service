{
  "type": "controller",
  "name": "EnquadramentoController",
  "module": "colaboradores",
  "basePath": "api/v1/rh/funcionarios/{funcionarioId}/enquadramentos",
  "description": "Gestão de enquadramentos profissionais (carreira, categoria, escalão, cargo)",
  "actions": [
    {
      "actionName": "getEnquadramentosHistorico",
      "method": "GET",
      "path": "",
      "summary": "Listar histórico completo de enquadramentos do funcionário",
      "pathVariables": [{ "type": "string", "name": "funcionarioId", "isRequired": true }],
      "responses": { "200": { "name": "OK", "content": { "application/json": { "schema": { "type": "WrapperListaEnquadramento", "objectType": "dto", "name": "data", "collectionType": "none", "module": "colaboradores" } } } } }
    },
    {
      "actionName": "getEnquadramentoAtual",
      "method": "GET",
      "path": "atual",
      "summary": "Obter enquadramento actual (isCurrent=true) do funcionário",
      "pathVariables": [{ "type": "string", "name": "funcionarioId", "isRequired": true }],
      "responses": { "200": { "name": "OK", "content": { "application/json": { "schema": { "type": "EnquadramentoResponse", "objectType": "dto", "name": "data", "collectionType": "none", "module": "colaboradores" } } } } }
    },
    {
      "actionName": "createEnquadramento",
      "method": "POST",
      "path": "",
      "summary": "Criar novo enquadramento — fecha o anterior automaticamente",
      "pathVariables": [{ "type": "string", "name": "funcionarioId", "isRequired": true }],
      "requestBody": { "content": { "application/json": { "schema": { "type": "EnquadramentoRequest", "collectionType": "none", "name": "data", "objectType": "dto", "module": "colaboradores" } } } },
      "responses": { "201": { "name": "CREATED", "content": { "application/json": { "schema": { "type": "map", "objectType": "java", "name": "data", "collectionType": "none" } } } } }
    },
    {
      "actionName": "getEnquadramentoById",
      "method": "GET",
      "path": "{enquadramentoId}",
      "pathVariables": [{ "type": "string", "name": "funcionarioId", "isRequired": true }, { "type": "string", "name": "enquadramentoId", "isRequired": true }],
      "responses": { "200": { "name": "OK", "content": { "application/json": { "schema": { "type": "EnquadramentoResponse", "objectType": "dto", "name": "data", "collectionType": "none", "module": "colaboradores" } } } } }
    }
  ]
}
