{
  "type": "controller",
  "name": "Horario",
  "module": "parametrizacoes",
  "description": "Catálogo de horários da instituição (Lei n.º 20/X/2023, arts. 164.º a 166.º)",
  "basePath": "api/v1/rh/catalogs/horarios",
  "actions": [
    {
      "actionName": "listHorarios",
      "method": "GET",
      "responses": {
        "200": { "name": "OK", "content": { "application/json": { "schema": {
          "type": "HorarioResponseDTO", "objectType": "dto", "name": "data", "collectionType": "list", "module": "parametrizacoes" } } } }
      },
      "requestParams": [
        { "type": "boolean", "name": "isActive", "isRequired": false }
      ]
    },
    {
      "actionName": "getHorarioById",
      "path": "{horarioId}",
      "method": "GET",
      "responses": {
        "200": { "name": "OK", "content": { "application/json": { "schema": {
          "type": "HorarioResponseDTO", "objectType": "dto", "name": "data", "collectionType": "none", "module": "parametrizacoes" } } } }
      },
      "pathVariables": [ { "name": "horarioId", "type": "string", "isRequired": true } ]
    },
    {
      "actionName": "createHorario",
      "method": "POST",
      "requestBody": { "content": { "application/json": { "schema": {
        "type": "HorarioRequest", "collectionType": "none", "name": "data", "objectType": "dto", "module": "parametrizacoes" } } } },
      "responses": {
        "201": { "name": "Created", "content": { "application/json": { "schema": {
          "type": "SuccessResponseDTO", "objectType": "dto", "name": "data", "collectionType": "none", "module": "shared" } } } }
      }
    },
    {
      "actionName": "updateHorario",
      "path": "{horarioId}",
      "method": "PUT",
      "requestBody": { "content": { "application/json": { "schema": {
        "type": "HorarioRequest", "collectionType": "none", "name": "data", "objectType": "dto", "module": "parametrizacoes" } } } },
      "responses": {
        "200": { "name": "OK", "content": { "application/json": { "schema": {
          "type": "HorarioResponseDTO", "objectType": "dto", "name": "data", "collectionType": "none", "module": "parametrizacoes" } } } }
      },
      "pathVariables": [ { "name": "horarioId", "type": "string", "isRequired": true } ]
    },
    {
      "actionName": "desativarHorario",
      "path": "{horarioId}",
      "method": "DELETE",
      "responses": {
        "200": { "name": "OK", "content": { "application/json": { "schema": {
          "type": "SuccessResponseDTO", "objectType": "dto", "name": "data", "collectionType": "none", "module": "shared" } } } }
      },
      "pathVariables": [ { "name": "horarioId", "type": "string", "isRequired": true } ]
    },
    {
      "actionName": "activateHorario",
      "path": "{horarioId}/activate",
      "method": "PATCH",
      "responses": {
        "200": { "name": "OK", "content": { "application/json": { "schema": {
          "type": "SuccessResponseDTO", "objectType": "dto", "name": "data", "collectionType": "none", "module": "shared" } } } }
      },
      "pathVariables": [ { "name": "horarioId", "type": "string", "isRequired": true } ]
    },
    {
      "actionName": "marcarHorarioBase",
      "path": "{horarioId}/base",
      "method": "PATCH",
      "responses": {
        "200": { "name": "OK", "content": { "application/json": { "schema": {
          "type": "HorarioResponseDTO", "objectType": "dto", "name": "data", "collectionType": "none", "module": "parametrizacoes" } } } }
      },
      "pathVariables": [ { "name": "horarioId", "type": "string", "isRequired": true } ]
    }
  ]
}
